# Supabase (required)
SUPABASE_URL=https://brawengrbiuvnmsyqhoe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=tweet_vault

# Embeddings (Google/Gemini preferred, OpenAI fallback)
GOOGLE_API_KEY=your-google-api-key
# GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Optional: Twitter session cookies for automated extraction
# If not set, Bird CLI will try to extract from Safari
TWITTER_AUTH_TOKEN=your-auth-token
TWITTER_CT0=your-ct0-token
