# Supabase (required)
SUPABASE_URL=https://brawengrbiuvnmsyqhoe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=tweet_vault

# Embeddings (OpenRouter OpenAI model by default, direct OpenAI fallback)
OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openai-api-key
# EMBEDDING_PROVIDER=openrouter
# GEMINI_API_KEY=your-gemini-api-key  # only when EMBEDDING_PROVIDER=gemini

# Optional: Twitter session cookies for automated extraction
# If not set, Bird CLI will try to extract from Safari
TWITTER_AUTH_TOKEN=your-auth-token
TWITTER_CT0=your-ct0-token
